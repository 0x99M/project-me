# Token from @BotFather. Secret — never commit the real value.
TELEGRAM_BOT_TOKEN=123456789:AA...

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Anything from anyone else is ignored. Must be non-empty or the bot refuses to start.
# To find your ID: start the bot with a placeholder here, message it, and read the
# "denied" log line — it prints the sender's ID.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Postgres DSN for the /todo checklist, /money ledger and /calendar. Optional: leave
# it unset and the bot runs normally with only those commands disabled. On Railway,
# set this to a reference variable — ${{Postgres.DATABASE_URL}} — using the private URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional, from https://my.telegram.org -> API development tools. With both set,
# /video_audio downloads videos up to 100 MB; without them, only up to 20 MB (the
# Bot API's download limit). Set both or neither. The hash is a secret.
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
